# Copy to backend/.env and fill in. Never commit the real file.

# Alpaca market data — free keys at https://app.alpaca.markets (Paper account → API Keys)
APCA_API_KEY_ID=your-key-id
APCA_API_SECRET_KEY=your-secret-key

# Optional: "iex" (free, real-time, IEX exchange only) or "sip" (paid, all exchanges)
# ALPACA_QUOTE_FEED=iex
# Optional: candles feed. "sip" is free for data older than 15 minutes; falls back to iex.
# ALPACA_HISTORY_FEED=sip

# Optional: Postgres in production (Render / Supabase). Defaults to local SQLite.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional: extra allowed frontend origins, comma-separated
# FRONTEND_ORIGINS=https://your-app.vercel.app

# Optional: starting virtual cash per player
# STARTING_CASH=100000
